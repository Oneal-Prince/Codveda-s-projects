{
  "name": "taskflow-component-library",
  "version": "1.0.0",
  "description": "A reusable and accessible React component library for TaskFlow applications.",
  "type": "module",
  "main": "./dist/taskflow-component-library.umd.cjs",
  "module": "./dist/taskflow-component-library.js",
  "exports": {
    ".": {
      "import": "./dist/taskflow-component-library.js",
      "require": "./dist/taskflow-component-library.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
